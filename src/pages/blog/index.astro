---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ca">
	<head>
		<BaseHead title={`Relatos — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			h1 {
				margin-bottom: 1em;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2rem;
			}
			ul li img {
				display: block;
				width: 100%;
				height: 240px;
				object-fit: cover;
				margin-bottom: 0.5rem;
			}
			ul li:first-child img {
				height: 340px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--tinta);
				line-height: 1.15;
			}
			.meta {
				margin: 0.5em 0;
				color: var(--piedra);
				display: flex;
				gap: 0.75em;
				flex-wrap: wrap;
			}
			ul li:first-child .meta {
				justify-content: center;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--oro-viejo);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.4em;
				}
				ul li:first-child .meta {
					justify-content: center;
				}
				.meta {
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Relatos</h1>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}
									<h4 class="title">{post.data.title}</h4>
									<div class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.location && <span class="location">{post.data.location}</span>}
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
