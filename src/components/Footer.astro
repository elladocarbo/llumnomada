---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Explicant el món, un lloc a la vegada.</p>
	<div class="social-links">
		<a href="/rss.xml">RSS</a>
		<a href="mailto:hola@llumnomada.cat">Contacte</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: rgb(var(--gray-dark));
		color: var(--sand);
		text-align: center;
	}
	footer p {
		margin: 0 0 0.5em 0;
		opacity: 0.85;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--accent-light);
		font-weight: 700;
	}
	.social-links a:hover {
		color: var(--sand);
	}
</style>
