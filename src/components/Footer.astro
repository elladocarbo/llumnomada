---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<img src="/favicon.svg" alt="" width="26" height="26" />
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Explicant el món, un lloc a la vegada.</p>
	<div class="social-links">
		<a href="/rss.xml">RSS</a>
		<a href="mailto:hola@llumnomada.com">Contacte</a>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 6em 1em;
		background: var(--tinta);
		color: var(--vitela);
		text-align: center;
	}
	footer img {
		display: block;
		margin: 0 auto 1em auto;
		opacity: 0.85;
	}
	footer p {
		margin: 0 0 0.8em 0;
		opacity: 0.75;
		font-family: var(--font-mono);
		font-size: 0.7em;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--oro-logo);
		font-family: var(--font-mono);
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		border-bottom: 1px solid var(--oro-logo);
	}
	.social-links a:hover {
		color: var(--vitela);
		border-color: var(--vitela);
	}
</style>
