---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">☀ {SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Inici</HeaderLink>
			<HeaderLink href="/blog">Bloc</HeaderLink>
			<HeaderLink href="/about">Sobre mi</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--gray-dark));
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--sand);
		font-weight: 700;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em 0;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--sand);
		opacity: 0.85;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a:hover {
		opacity: 1;
	}
	nav a.active {
		opacity: 1;
		text-decoration: none;
		border-bottom-color: var(--accent-light);
	}
	@media (max-width: 480px) {
		nav {
			justify-content: center;
			text-align: center;
			padding: 0.5em 0;
		}
		.internal-links {
			display: flex;
			justify-content: center;
			width: 100%;
		}
	}
</style>
